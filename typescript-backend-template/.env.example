# Copia questo file in .env (cp .env.example .env) e modifica i valori.
# Node carica .env automaticamente negli script "dev" e "start" (flag --env-file-if-exists).
# Le variabili gia' presenti nell'ambiente hanno la precedenza su quelle del file.

# Ambiente: development | test | production
NODE_ENV=development

# Indirizzo e porta HTTP (0.0.0.0 = in ascolto su tutte le interfacce, necessario in Docker)
HOST=0.0.0.0
PORT=3001

# Livello di log: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Origini consentite dal CORS, separate da virgola ("*" = tutte)
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5200,http://localhost:5300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084
