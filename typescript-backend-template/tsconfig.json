{
  // Configurazione TypeScript usata SOLO per il type-check (tsc --noEmit), l'editor e ESLint.
  // La trasformazione TS -> JS la fanno Node (type stripping in dev), Vite (build) e Vitest (test).
  "compilerOptions": {
    // Node 24+ supporta nativamente ES2024.
    "target": "ES2024",
    "lib": ["ES2024"],
    // ESM "vero" con le regole di risoluzione di Node (import con estensione esplicita).
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Da TypeScript 6 "types" e' vuoto di default: abilitiamo esplicitamente i tipi di Node.
    "types": ["node"],

    // Massima severita' del type-checker.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    // Compatibilita' con il "type stripping" nativo di Node: solo sintassi TS cancellabile
    // (niente enum, namespace, parameter properties) e import di soli tipi espliciti.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,

    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "tests", "vite.config.ts", "eslint.config.js"]
}
