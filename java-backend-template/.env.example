# Copia questo file in .env e modifica i valori. Spring Boot legge .env all'avvio
# (spring.config.import in application.yml); in alternativa esporta le variabili nella shell.

# Porta HTTP del backend.
PORT=8080

# Origini consentite dal CORS, separate da virgola.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5200,http://localhost:5300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# Livello di log: debug, info, warn, error.
LOG_LEVEL=info

# Profilo Spring: dev (log testuali, default) o prod (log JSON).
# Nota: va impostato come variabile d'ambiente reale (shell, Docker), non viene letto da .env.
# SPRING_PROFILES_ACTIVE=prod
