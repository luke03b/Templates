# Copia questo file in ".env" (cp .env.example .env) e modifica i valori.
# Il file .env viene letto da "npm run dev" e "npm start" tramite --env-file-if-exists.
# In Docker le variabili si passano con "docker run -e" o nel docker-compose.

# Porta HTTP del server.
PORT=3000

# Origini CORS consentite, separate da virgola. Usa "*" per consentire tutte le origini.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5200,http://localhost:5300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# Livello di log: debug, info, warn, error.
LOG_LEVEL=info

# Ambiente di esecuzione: development, production, test.
NODE_ENV=development

# Millisecondi concessi alle richieste in corso durante lo spegnimento (graceful shutdown).
SHUTDOWN_TIMEOUT_MS=10000
