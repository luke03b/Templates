# Template di configurazione nginx. All'avvio l'immagine ufficiale sostituisce ${API_UPSTREAM}
# (envsubst) e scrive il risultato in /etc/nginx/conf.d/default.conf.
# NB: le variabili nginx come $uri non vengono toccate perche' envsubst sostituisce solo le
# variabili d'ambiente definite.

server {
    # Solo IPv4: "listen [::]:80" fallisce su host/container senza IPv6.
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interno di Docker: permette di risolvere il nome del backend A RUNTIME (a ogni
    # richiesta, cache 10s). Cosi' nginx parte anche se il backend non esiste ancora.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    # --- Compressione ----------------------------------------------------------
    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json
               application/problem+json image/svg+xml application/xml;

    # --- Health check del container (usato da HEALTHCHECK nel Dockerfile) ------
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # --- Reverse proxy verso il backend --------------------------------------
    # Con una variabile in proxy_pass nginx inoltra l'URI originale completo (/api/...).
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # --- Asset statici con hash nel nome: cache lunga e immutabile --------------
    location ~* \.(?:js|css|woff2?|ttf|svg|png|jpe?g|gif|webp|avif|ico)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # --- Fallback SPA: ogni rotta sconosciuta restituisce index.html -----------
    # index.html non va in cache, cosi' dopo un deploy il browser scarica i nuovi bundle.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
