# Template di configurazione nginx. L'immagine ufficiale nginx sostituisce
# le variabili ${...} con envsubst all'avvio del container e scrive il
# risultato in /etc/nginx/conf.d/default.conf.
server {
    # Solo IPv4: [::]:80 fa fallire l'avvio su host senza IPv6.
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS interno di Docker. Usando una variabile in proxy_pass nginx risolve
    # l'host a ogni richiesta (non all'avvio): il container parte anche se il
    # backend non esiste ancora; in quel caso /api risponde 502.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream ${API_UPSTREAM};

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json
               application/wasm image/svg+xml font/otf font/ttf;

    # Reverse proxy verso il backend: /api/items -> ${API_UPSTREAM}/api/items.
    location /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Endpoint di salute del solo nginx (usato dall'HEALTHCHECK del Dockerfile).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Flutter web NON aggiunge hash ai nomi dei file (main.dart.js resta
    # uguale tra un deploy e l'altro): JS/JSON/HTML vanno quindi sempre
    # rivalidati. "no-cache" non disattiva la cache: il browser chiede al
    # server se il file è cambiato (ETag) e riceve un 304 leggero se no.
    location ~* \.(?:html|js|mjs|json|bin)$ {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # Immagini, font e WebAssembly cambiano raramente: cache di 7 giorni.
    location ~* \.(?:wasm|png|jpg|jpeg|gif|svg|ico|webp|otf|ttf|woff2?|frag)$ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }

    # Fallback SPA: qualsiasi altro percorso (/items, /components...) serve
    # index.html e il routing lo gestisce go_router nel browser.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
