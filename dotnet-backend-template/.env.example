# Copia questo file in .env (cp .env.example .env). Il file .env NON va committato.
# Le variabili d'ambiente reali hanno sempre la precedenza sui valori di .env.

# Porta HTTP del backend (locale 5080; nel container l'immagine imposta 8080).
PORT=5080

# Origini CORS consentite, separate da virgola. "*" consente qualsiasi origine.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5200,http://localhost:5300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# Livello di log: debug, info, warn, error.
LOG_LEVEL=info
