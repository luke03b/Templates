@* AppButton: bottone riutilizzabile con varianti, dimensioni, stato disabled e loading.
   Esempio: <AppButton Variant="ButtonVariant.Primary" Loading="saving" OnClick="SaveAsync">Salva</AppButton> *@

<button type="@Type"
        class="@CssClass"
        disabled="@(Disabled || Loading)"
        aria-busy="@(Loading ? "true" : null)"
        @onclick="OnClick"
        @attributes="AdditionalAttributes">
    @if (Loading)
    {
        <Spinner Size="ButtonSize.Small" Label="Loading" />
    }
    @ChildContent
</button>

@code {
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>"button" (default) oppure "submit" dentro una EditForm.</summary>
    [Parameter] public string Type { get; set; } = "button";

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Mostra lo spinner e disabilita il bottone (evita doppi click durante una chiamata).</summary>
    [Parameter] public bool Loading { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Attributi extra (aria-label, title, data-*...) passati così come sono al &lt;button&gt;.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string CssClass => UiCss.Join(
        "btn",
        $"btn-{Variant.ToString().ToLowerInvariant()}",
        Size switch { ButtonSize.Small => "btn-sm", ButtonSize.Large => "btn-lg", _ => null });
}
