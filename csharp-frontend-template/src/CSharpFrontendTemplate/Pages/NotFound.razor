@* NotFound: pagina 404. In .NET 10 il Router la usa tramite NotFoundPage="typeof(Pages.NotFound)"
   per qualsiasi URL che non corrisponde a nessuna @page. *@
@page "/not-found"

<PageTitle>Page not found · CSharp Frontend Template</PageTitle>

<section class="empty-state">
    <p class="empty-state-code">404</p>
    <h1>Page not found</h1>
    <p>The page you are looking for does not exist or has been moved.</p>
    <a class="btn btn-primary" href="">Back to home</a>
</section>
