# Configurazione nginx per servire la SPA in produzione (Docker).
# E' un TEMPLATE: all'avvio l'entrypoint ufficiale di nginx sostituisce ${API_UPSTREAM}
# con il valore della variabile d'ambiente e scrive il risultato in /etc/nginx/conf.d/default.conf.

server {
    # Solo IPv4: alcuni host Docker non hanno IPv6 e nginx non partirebbe.
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS interno di Docker: risolve il nome del backend a ogni richiesta (valid=10s),
    # cosi' nginx parte anche se il backend non esiste ancora (l'app mostra "Offline").
    resolver 127.0.0.11 valid=10s ipv6=off;
    resolver_timeout 5s;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Reverse proxy delle API: /api/items -> ${API_UPSTREAM}/api/items.
    # Usare una variabile in proxy_pass obbliga nginx a risolvere l'host a runtime.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Endpoint di salute del container (usato dall'HEALTHCHECK del Dockerfile).
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Asset generati da Vite: il nome contiene un hash, quindi si possono mettere in cache "per sempre".
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # index.html non va mai messo in cache, altrimenti gli utenti non vedono i nuovi deploy.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Fallback SPA: ogni URL sconosciuto (es. /items) restituisce index.html e decide React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
