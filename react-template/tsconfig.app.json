// Configurazione TypeScript per il codice dell'app (cartella src, eseguito nel browser).
{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // TypeScript 6 non include piu automaticamente tutti i @types: li elenchiamo.
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom/vitest"],

    // Vite fa il bundling: TypeScript serve solo come type checker.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,

    // Regole di rigore: meglio un errore in compilazione che un bug a runtime.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,

    // Alias "@/..." -> "src/..." (lo stesso alias e' definito in vite.config.ts).
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
