# Copia questo file in `.env` e modifica i valori. `.env` non va mai committato.
# Le variabili d'ambiente reali hanno sempre la precedenza sui valori scritti qui.

# Porta HTTP del backend (contratto: 8000 sia in locale sia nel container).
PORT=8000

# Interfaccia di ascolto: 127.0.0.1 in locale, 0.0.0.0 nel container (impostato nel Dockerfile).
HOST=127.0.0.1

# Origini consentite dal CORS, separate da virgola.
CORS_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:5200,http://localhost:5300,http://localhost:8081,http://localhost:8082,http://localhost:8083,http://localhost:8084

# Livello di log: debug, info, warn, error.
LOG_LEVEL=info
